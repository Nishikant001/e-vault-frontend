# Copy this file to .env (or .env.local) and adjust for your environment.
# See src/services/apiClient.js — this is the ONLY place the frontend reads
# the backend base URL from. If unset, it falls back to
# http://localhost:3000/api (today's hardcoded default) so local dev keeps
# working with no .env file present.
VITE_API_BASE_URL=http://localhost:3000/api

# ── Internal Communication Module — Calling ─────────────────────────
# Optional. STUN-only by default (works for many networks but NOT all —
# symmetric NATs/some corporate firewalls need a TURN server). Format is
# the standard RTCConfiguration.iceServers array, JSON-stringified:
# VITE_COMMUNICATION_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn-host:3478","username":"...","credential":"..."}]
# VITE_CHAT_ATTACHMENT_MAX_FILES=10
